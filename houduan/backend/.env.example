# ===== javahouduan 后端环境变量样例 =====
# 用法：复制为 .env 或 secrets.bat（secrets.bat 已被 .gitignore 忽略），填入真实值后由启动脚本加载。
# 生产环境必须设置 JWT_SECRET、ADMIN_INIT_PASSWORD、MONGO_URI。

# DeepSeek 对话模型 API Key（必填，否则 AI 功能不可用）
DEEPSEEK_API_KEY=

# DeepSeek 模型名（可选，默认 deepseek-flash）
DEEPSEEK_MODEL=deepseek-flash

# 智谱 GLM API Key（可选，仅 learning-agent 模块使用）
GLM_API_KEY=

# JWT 签名密钥（生产必填，建议 ≥32 字节随机串；本地留空则用开发默认值）
JWT_SECRET=

# 管理员初始口令（生产必填，勿用默认 123456789）
ADMIN_INIT_PASSWORD=

# MongoDB 连接串（可选，默认 mongodb://localhost:27017/student_db）
MONGO_URI=mongodb://localhost:27017/student_db

# 激活的 profile：dev / prod
SPRING_PROFILES_ACTIVE=dev
